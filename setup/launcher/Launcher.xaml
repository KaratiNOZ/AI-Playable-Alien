<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1150" Height="736" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Foreground="#EAF0F6" FontFamily="Segoe UI" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EAF0F6"/>
    <SolidColorBrush x:Key="Muted" Color="#A5B4C2"/>
    <SolidColorBrush x:Key="Good" Color="#9AD5B4"/>
    <SolidColorBrush x:Key="Warning" Color="#F6C085"/>
    <SolidColorBrush x:Key="Line" Color="#3B4440"/>
    <SolidColorBrush x:Key="Accent" Color="#FFB77D"/>
    <SolidColorBrush x:Key="Canvas" Color="#111515"/>
    <SolidColorBrush x:Key="Rail" Color="#171C19"/>
    <SolidColorBrush x:Key="CardFill" Color="#1D2421"/>
    <SolidColorBrush x:Key="ControlFill" Color="#242C29"/>
    <SolidColorBrush x:Key="FieldFill" Color="#131917"/>
    <SolidColorBrush x:Key="SelectedFill" Color="#31382F"/>
    <SolidColorBrush x:Key="RadarFill" Color="#DA1D2421"/>
    <Geometry x:Key="AlienMark">M 3,12 C 5,7 9,4 15,4 C 21,4 25,7 26,10 L 26,14 L 22,14 L 21,20 L 16,23 L 11,21 L 11,17 L 6,16 Z M 8,12 L 18,12 L 22,10 M 14,17 L 19,17</Geometry>
    <Geometry x:Key="HomeMark">M 2,9 L 9,3 L 16,9 M 4,8 L 4,16 L 14,16 L 14,8 M 7,16 L 7,11 L 11,11 L 11,16</Geometry>
    <Geometry x:Key="SetupMark">M 3,4 L 15,4 M 3,9 L 15,9 M 3,14 L 15,14 M 6,2 L 6,6 M 12,7 L 12,11 M 8,12 L 8,16</Geometry>
    <Geometry x:Key="LogsMark">M 2,9 L 5,9 L 7,4 L 10,14 L 12,9 L 16,9</Geometry>
    <Geometry x:Key="LinksMark">M 6,7 L 4,7 A 3,3 0 0 0 4,13 L 7,13 A 3,3 0 0 0 10,10 M 12,11 L 14,11 A 3,3 0 0 0 14,5 L 11,5 A 3,3 0 0 0 8,8 M 6,12 L 12,6</Geometry>
    <Geometry x:Key="ExternalMark">M 4,6 L 4,16 L 14,16 L 14,11 M 9,3 L 16,3 L 16,10 M 16,3 L 8,11</Geometry>
    <Geometry x:Key="NexusMark">M 3,3 L 8,3 L 8,8 L 3,8 Z M 10,3 L 15,3 L 15,8 L 10,8 Z M 3,10 L 8,10 L 8,15 L 3,15 Z M 10,10 L 15,10 L 15,15 L 10,15 Z</Geometry>
    <Geometry x:Key="RepoMark">M 6,4 L 2,9 L 6,14 M 12,4 L 16,9 L 12,14 M 10,3 L 8,15</Geometry>
    <Geometry x:Key="DiscordMark">M 3,3 L 15,3 L 15,12 L 9,12 L 5,16 L 5,12 L 3,12 Z M 6,8 L 7,8 M 11,8 L 12,8</Geometry>
    <Geometry x:Key="VideoMark">M 2,4 L 16,4 L 16,14 L 2,14 Z M 7,6 L 12,9 L 7,12 Z</Geometry>

    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21"/></DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.50"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="#101B25"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="23,13"/>
      <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="BorderThickness" Value="2,1,1,1"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path Data="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"
                    Stroke="{DynamicResource Accent}" StrokeThickness="1.5" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding}" LineHeight="21"/>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="Selected">
          <Setter Property="Background" Value="{DynamicResource SelectedFill}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LinkCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="Normal" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource SelectedFill}" CornerRadius="7"
                      Width="34" Height="34" VerticalAlignment="Center">
                <Path Data="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{DynamicResource Accent}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="13"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Canvas}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" Padding="2,2,2,2">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="24">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Handle" Background="{DynamicResource Line}" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Accent}"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Accent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="4">
              <Ellipse x:Name="Thumb" Width="15" Height="15" HorizontalAlignment="Left" Fill="{StaticResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SelectedFill}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
              <Trigger Property="Tag" Value="Unavailable">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource FieldFill}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Muted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Foreground="{StaticResource Ink}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="7">
                      <Grid Margin="11,0">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="3">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Option" Background="Transparent" Padding="9,6" CornerRadius="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource SelectedFill}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="ContentTemplate">
        <Setter.Value><DataTemplate><TextBlock Margin="7,0,0,0" Text="{Binding}"/></DataTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="19,24,19,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="1,2,0,22">
            <Border Width="39" Height="39" CornerRadius="11" Background="{DynamicResource SelectedFill}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.65" StrokeLineJoin="Round" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Data="{StaticResource AlienMark}"/>
            </Border>
            <TextBlock x:Name="Brand" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="21" FontWeight="Bold">
              <Run Text="Gagen's"/><LineBreak/><Run Text="Playable Alien"/>
            </TextBlock>
          </StackPanel>
          <Button x:Name="NavHome" Style="{StaticResource Nav}" CommandParameter="{StaticResource HomeMark}"/>
          <Button x:Name="NavSetup" Style="{StaticResource Nav}" CommandParameter="{StaticResource SetupMark}"/>
          <Button x:Name="NavLogs" Style="{StaticResource Nav}" CommandParameter="{StaticResource LogsMark}"/>
          <Button x:Name="NavLinks" Style="{StaticResource Nav}" CommandParameter="{StaticResource LinksMark}"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Label x:Name="ThemeLabel" Foreground="{DynamicResource Muted}" Padding="3,0,0,5" FontSize="14"/>
          <ComboBox x:Name="Theme" Height="38" Margin="0,0,10,8" AutomationProperties.Name="{Binding Content, ElementName=ThemeLabel}"/>
          <Label x:Name="LanguageLabel" Foreground="{StaticResource Muted}" Padding="3,0,0,6" FontSize="14"/>
          <ComboBox x:Name="Language" Height="38" Margin="0,0,10,0" AutomationProperties.Name="{Binding Content, ElementName=LanguageLabel}"/>
          <TextBlock x:Name="Version" Margin="3,12,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,22,24,20">
          <StackPanel x:Name="HomePage">
            <Border CornerRadius="11" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinHeight="252">
              <Border.Background><ImageBrush x:Name="HeroPhoto" Stretch="UniformToFill" AlignmentY="Center"/></Border.Background>
              <Border CornerRadius="10" Padding="24,17">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.6" EndPoint="1,0.44">
                    <GradientStop Color="#F80B1520" Offset="0"/>
                    <GradientStop Color="#DD111E2A" Offset="0.52"/>
                    <GradientStop Color="#7212222D" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Alien: Isolation" FontSize="15" FontWeight="SemiBold"
                               Foreground="#C5DDF1" Margin="1,0,0,5"/>
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                      <TextBlock x:Name="HeroTitle" TextWrapping="NoWrap" FontSize="57" FontWeight="Bold" LineHeight="52">
                        <Run Text="Gagen's"/><LineBreak/><Run Text="Playable Alien"/>
                      </TextBlock>
                    </Viewbox>
                    <TextBlock x:Name="HomeIntro" Style="{StaticResource Hint}" Foreground="#DBE8F2" Margin="1,9,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" MaxWidth="170" Background="{DynamicResource RadarFill}" BorderBrush="{DynamicResource Line}"
                          BorderThickness="1" CornerRadius="10" Padding="6" VerticalAlignment="Center">
                    <ContentControl x:Name="Radar" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Height="152" Focusable="False"/>
                  </Border>
                </Grid>
              </Border>
            </Border>
            <UniformGrid Columns="2" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,5,10" MinHeight="93" Padding="15,12">
                  <StackPanel>
                    <TextBlock x:Name="HomeGameLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="HomeGame" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,10" MinHeight="93" Padding="15,12">
                  <StackPanel>
                    <TextBlock x:Name="HomeModLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="HomeMod" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" MinHeight="93" Padding="15,12">
                  <StackPanel>
                    <TextBlock x:Name="HomeFilesLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="HomeFiles" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" MinHeight="93" Padding="15,12">
                  <StackPanel>
                    <TextBlock x:Name="HomeVersionLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="HomeVersion" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
            </UniformGrid>
          </StackPanel>

          <StackPanel x:Name="SetupPage" Visibility="Collapsed">
            <TextBlock x:Name="SetupTitle" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,8,0,15">
              <StackPanel>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Alien: Isolation" Style="{StaticResource CardTitle}" Margin="0,0,10,0"/>
                  <TextBlock x:Name="SetupGameState" Grid.Column="1" Style="{StaticResource Hint}" MaxWidth="216" VerticalAlignment="Center"/>
                </Grid>
                <Label x:Name="GameLabel" Target="{Binding ElementName=GamePath}" Padding="0,0,0,6" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="GamePath" MinHeight="42" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="GamePathHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,11,0,0">
                  <Button x:Name="Find" Margin="0,0,7,4"/>
                  <Button x:Name="Browse" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="ComponentTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,9"/>
            <UniformGrid x:Name="ComponentGrid" Columns="1">
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock x:Name="TreeTitle" Style="{StaticResource CardTitle}"/>
                      <TextBlock x:Name="TreeDesc" Style="{StaticResource Hint}"/>
                      <TextBlock x:Name="TreeAvailability" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="Tree" Style="{StaticResource Switch}" IsChecked="True"
                              AutomationProperties.Name="{Binding Text, ElementName=TreeTitle}"
                              AutomationProperties.HelpText="{Binding Text, ElementName=TreeAvailability}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock x:Name="LevelsTitle" Style="{StaticResource CardTitle}"/>
                      <TextBlock x:Name="LevelsDesc" Style="{StaticResource Hint}"/>
                      <TextBlock x:Name="LevelNote" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="Levels" Style="{StaticResource Switch}"
                              AutomationProperties.Name="{Binding Text, ElementName=LevelsTitle}"
                              AutomationProperties.HelpText="{Binding Text, ElementName=LevelNote}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock x:Name="ShortcutTitle" Style="{StaticResource CardTitle}"/>
                      <TextBlock x:Name="ShortcutDesc" Style="{StaticResource Hint}"/>
                      <TextBlock x:Name="ShortcutAvailability" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="Shortcut" Style="{StaticResource Switch}" IsChecked="True"
                              AutomationProperties.Name="{Binding Text, ElementName=ShortcutTitle}"
                              AutomationProperties.HelpText="{Binding Text, ElementName=ShortcutAvailability}"/>
                  </Grid>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,9,0,0">
              <StackPanel>
                <TextBlock x:Name="MaintenanceTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="MaintenanceIntro" Style="{StaticResource Hint}"/>
                <WrapPanel Margin="0,11,0,0">
                  <Button x:Name="Verify" Margin="0,0,7,5"/>
                  <Button x:Name="Restore" Margin="0,0,7,5"/>
                  <Button x:Name="Play" Margin="0,0,0,5"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LogsPage" Visibility="Collapsed">
            <TextBlock x:Name="LogsTitle" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="LogsIntro" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,5,8" Padding="13,10">
                  <StackPanel>
                    <TextBlock x:Name="DiagGameLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="DiagGame" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,8" Padding="13,10">
                  <StackPanel>
                    <TextBlock x:Name="DiagPathLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="DiagPath" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,5,8" Padding="13,10">
                  <StackPanel>
                    <TextBlock x:Name="DiagTreeLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="DiagTree" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,8" Padding="13,10">
                  <StackPanel>
                    <TextBlock x:Name="DiagFilesLabel" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="DiagFiles" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="13,10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="DiagHealthLabel" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="DiagHealth" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock x:Name="ReportTitle" Style="{StaticResource CardTitle}"/>
                <WrapPanel Margin="0,6,0,6">
                  <Button x:Name="OpenLogs" Margin="0,0,7,7"/>
                  <Button x:Name="OpenInstallerLog" Margin="0,0,7,7"/>
                  <Button x:Name="ToggleErrors" Margin="0,0,7,7"/>
                  <Button x:Name="Copy" Margin="0,0,0,7"/>
                </WrapPanel>
                <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" MinHeight="205" MaxHeight="340"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LinksPage" Visibility="Collapsed">
            <TextBlock x:Name="LinksTitle" Style="{StaticResource PageTitle}" Margin="0,0,0,17"/>
            <UniformGrid Columns="2">
                <Button x:Name="NexusLink" Content="Nexus Mods" Style="{StaticResource LinkCard}" MinHeight="86"
                        Margin="0,0,5,9" CommandParameter="{StaticResource NexusMark}"/>
                <Button x:Name="RepoLink" Content="GitHub" Style="{StaticResource LinkCard}" MinHeight="86"
                        Margin="5,0,0,9" CommandParameter="{StaticResource RepoMark}"/>
                <Button x:Name="DiscordLink" Content="Discord" Style="{StaticResource LinkCard}" MinHeight="86"
                        Margin="0,0,5,9" CommandParameter="{StaticResource DiscordMark}"/>
                <Button x:Name="VideoLink" Content="YouTube" Style="{StaticResource LinkCard}" MinHeight="86"
                        Margin="5,0,0,9" CommandParameter="{StaticResource VideoMark}"/>
            </UniformGrid>
                            <Button x:Name="ReleasesLink" Style="{StaticResource LinkCard}" MinHeight="68"
                        Margin="0,0,0,15" CommandParameter="{StaticResource ExternalMark}"/>
            <TextBlock x:Name="CreditsTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,9"/>
            <UniformGrid Columns="2">
                <Button x:Name="PhotoLink" Content="Alpha Perspective · Unsplash" Style="{StaticResource LinkCard}" MinHeight="68"
                        Margin="0,0,5,9" CommandParameter="{StaticResource ExternalMark}"/>
                <Button x:Name="FontLink" Content="Jeremy Tribby · Barlow" Style="{StaticResource LinkCard}" MinHeight="68"
                        Margin="5,0,0,9" CommandParameter="{StaticResource ExternalMark}"/>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="1" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="14"/>
            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Accent}" FontSize="13" Visibility="Collapsed"/>
          </StackPanel>
          <Button x:Name="Primary" Grid.Column="1" Style="{StaticResource Primary}" MinWidth="174" MaxWidth="232"/>
          <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Visibility="Collapsed"
                       IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource ControlFill}" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
